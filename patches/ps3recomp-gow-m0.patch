diff --git a/runtime/spu/tests/test_spu_event_ack_sn.c b/runtime/spu/tests/test_spu_event_ack_sn.c
new file mode 100644
index 0000000..0fb8f0a
--- /dev/null
+++ b/runtime/spu/tests/test_spu_event_ack_sn.c
@@ -0,0 +1,60 @@
+/* SPU_WrEventAck through the real spu_channels.c: acknowledging Sn (0x2) while
+ * a DMA list is still parked on a stall-and-notify (list_stall_stat non-zero)
+ * leaves Sn pending. A resumed list runs inline, inside the MFC_WrListStallAck
+ * that resumes it, so its next stall can land before the handler acknowledges
+ * the event it was taken for; on hardware the MFC gets there after the ack.
+ * Other bits, and Sn with no list parked, are acknowledged as before. */
+#include "../spu_helpers.h"
+#include "../spu_interp.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+extern void spu_wrch(spu_context*, uint32_t, u128);
+
+static spu_context ctx;
+static int fails;
+static void ack(uint32_t bits) { spu_wrch(&ctx, SPU_WrEventAck, spu_splat_u32(bits)); }
+#define CHECK(c) do { if (!(c)) { fails++; fprintf(stderr, "FAIL line %d: %s (status 0x%X)\n", \
+                                                     __LINE__, #c, ctx.event_status); } } while (0)
+
+int main(void)
+{
+    static uint8_t ls[SPU_LS_SIZE];
+    spu_context_init(&ctx, 0);
+    ctx.ls = ls;
+
+    /* A list parked on tag 4: Sn stays pending through its ack, Lr is acked. */
+    ctx.list_stall_mask = ctx.list_stall_stat = 1u << 4;
+    ctx.event_status = 0x2u | 0x400u;
+    ack(0x2u | 0x400u);
+    CHECK(ctx.event_status == 0x2u);
+
+    /* Nothing parked: Sn is acked like any other event. */
+    ctx.list_stall_mask = ctx.list_stall_stat = 0;
+    ack(0x2u);
+    CHECK(ctx.event_status == 0);
+
+    /* An ack without Sn does not raise it, parked list or not. */
+    ctx.list_stall_stat = 1u << 4;
+    ctx.event_status = 0x1u;
+    ack(0x1u);
+    CHECK(ctx.event_status == 0);
+
+    printf("%s: WrEventAck keeps Sn pending while a list is parked\n", fails ? "FAIL" : "PASS");
+    return fails ? 1 : 0;
+}
+void ppu_resv_break_store(uint64_t ea){(void)ea;abort();}
+void ps3_ww_report_inline(uint32_t a,uint64_t v,int w){(void)a;(void)v;(void)w;abort();}
+unsigned long long ps3_ms_now(void){abort();}
+uint32_t g_ww_lo=0xFFFFFFFFu,g_ww_hi;int g_resv_store_active;
+uint32_t g_barrier_sync_watch;
+uint32_t g_ydkj_real_spurs_ea, g_ydkj_real_taskset_ea, g_ydkj_real_taskid;
+void spurs_ef_set_from_spu(uint32_t ea, uint16_t bits) { (void)ea; (void)bits; abort(); }
+void ydkj_wake_all_event_flags(void) { abort(); }
+void spurs_pm_build_context(spu_context* c, uint32_t a, uint32_t b, uint32_t d) {
+    (void)c; (void)a; (void)b; (void)d; abort();
+}
+uint32_t g_spu_image_src_ea, g_spu_image_ls_start, g_spu_image_span;
+void spu_thread_publish_ctx(uint32_t tid, void* c) { (void)tid; (void)c; abort(); }
diff --git a/runtime/spu/tests/test_spu_event_atomic.c b/runtime/spu/tests/test_spu_event_atomic.c
new file mode 100644
index 0000000..79ec5ad
--- /dev/null
+++ b/runtime/spu/tests/test_spu_event_atomic.c
@@ -0,0 +1,56 @@
+/* SPU event_status is updated from more than one host thread: the SPU's own
+ * (a list stall raises Sn, WrEventAck clears) and a PPU or peer-SPU store that
+ * kills its reservation (Lr, spu_coherency.c). Every update goes through
+ * SPU_EVENT_SET / SPU_EVENT_CLEAR, which are atomic. Here one thread raises
+ * and acknowledges Sn while another raises and acknowledges Lr on the same
+ * context, and Sn must never vanish between being raised and being acked.
+ * With a plain |= / &= (SPU_EVENT_PLAIN, the old code) it does: a raise that
+ * read the word before the other side's write puts back the stale value. */
+#include "spu_context.h"
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#ifdef SPU_EVENT_PLAIN
+#undef SPU_EVENT_SET
+#undef SPU_EVENT_CLEAR
+#define SPU_EVENT_SET(c, b)   (*(volatile uint32_t*)&(c)->event_status |= (b))
+#define SPU_EVENT_CLEAR(c, b) (*(volatile uint32_t*)&(c)->event_status &= ~(uint32_t)(b))
+#endif
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+
+enum { ROUNDS = 5000000 };
+static spu_context s_ctx;
+static volatile int s_started, s_done;
+
+static void* lr_raiser(void* arg)            /* the PPU / peer side */
+{
+    (void)arg;           /* Lr is 0x400 (SPU_EVENT_LR in spu_coherency.c) */
+    s_started = 1;
+    while (!s_done) {
+        SPU_EVENT_SET(&s_ctx, 0x400u);
+        SPU_EVENT_CLEAR(&s_ctx, 0x400u);
+    }
+    return NULL;
+}
+
+int main(void)
+{
+    pthread_t t;
+    pthread_create(&t, NULL, lr_raiser, NULL);
+    while (!s_started) ;                       /* both sides running before counting */
+    unsigned lost = 0;
+    for (unsigned i = 0; i < ROUNDS; i++) {   /* the SPU side: Sn raised, then acked */
+        SPU_EVENT_SET(&s_ctx, 0x2u);
+        for (volatile int k = 0; k < 16; k++) ;  /* the handler runs a little before it acks */
+        if (!(*(volatile uint32_t*)&s_ctx.event_status & 0x2u)) lost++;
+        SPU_EVENT_CLEAR(&s_ctx, 0x2u);
+    }
+    s_done = 1;
+    pthread_join(t, NULL);
+    printf("%s: Sn lost %u times in %u raises under concurrent Lr updates\n",
+           lost ? "FAIL" : "PASS", lost, (unsigned)ROUNDS);
+    return lost ? 1 : 0;
+}
diff --git a/runtime/spu/tests/test_spu_float_est.c b/runtime/spu/tests/test_spu_float_est.c
new file mode 100644
index 0000000..0cda949
--- /dev/null
+++ b/runtime/spu/tests/test_spu_float_est.c
@@ -0,0 +1,109 @@
+/* The vector spu_fi/frest/frsqest/cflts/cfltu/csflt/cuflt (AVX2 on x86) must be bit-identical
+ * to the scalar references (spu_*_ref) for every input: random words, ordinary floats, the
+ * normal/extended-range boundaries, zeros and denormals, integers of every magnitude, and every
+ * scale immediate. Prints a rough speed comparison too. Build on x86 with AVX2:
+ *   cc -O2 -mavx2 -mfma -I../../../include -I.. test_spu_float_est.c -o t && ./t */
+#include "../spu_helpers.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+
+static uint64_t s_rng = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd32(void)
+{
+    s_rng ^= s_rng << 13; s_rng ^= s_rng >> 7; s_rng ^= s_rng << 17;
+    return (uint32_t)(s_rng >> 16);
+}
+
+static uint32_t rnd_float(void)
+{
+    uint32_t sign = (rnd32() & 1u) << 31, man = rnd32() & 0x7FFFFFu, e;
+    switch (rnd32() % 10) {
+    case 0: e = 0; break;                              /* zero / denormal */
+    case 1: e = 1 + rnd32() % 4; break;                /* bottom of normal range */
+    case 2: e = 248 + rnd32() % 8; break;              /* top, into extended range */
+    case 3: return rnd32();                            /* anything */
+    case 4: return sign;                               /* +-0 */
+    default: e = 110 + rnd32() % 36; break;            /* ordinary */
+    }
+    return sign | (e << 23) | man;
+}
+
+static uint32_t rnd_int(void)
+{
+    switch (rnd32() % 6) {
+    case 0: return 0;
+    case 1: return 0x80000000u >> (rnd32() % 32);      /* powers of two */
+    case 2: return 0xFFFFFFFFu >> (rnd32() % 32);      /* all-ones runs */
+    case 3: return (uint32_t)-(int32_t)(rnd32() >> (rnd32() % 32));
+    default: return rnd32() >> (rnd32() % 32);         /* every magnitude */
+    }
+}
+
+static int same(u128 a, u128 b) { return !memcmp(a._u32, b._u32, 16); }
+
+static long s_bad;
+static void report(const char* op, int imm, u128 a, u128 b, u128 got, u128 want)
+{
+    if (s_bad++ < 20)
+        printf("MISMATCH %s imm=%d a=%08X %08X %08X %08X b=%08X %08X %08X %08X\n"
+               "  got  %08X %08X %08X %08X\n  want %08X %08X %08X %08X\n", op, imm,
+               a._u32[0], a._u32[1], a._u32[2], a._u32[3], b._u32[0], b._u32[1], b._u32[2], b._u32[3],
+               got._u32[0], got._u32[1], got._u32[2], got._u32[3],
+               want._u32[0], want._u32[1], want._u32[2], want._u32[3]);
+}
+
+#define CHECK1(op, a)        do { u128 got_ = spu_##op(a), want_ = spu_##op##_ref(a); \
+                                  if (!same(got_, want_)) report(#op, 0, a, a, got_, want_); } while (0)
+#define CHECK2(op, a, b)     do { u128 got_ = spu_##op(a, b), want_ = spu_##op##_ref(a, b); \
+                                  if (!same(got_, want_)) report(#op, 0, a, b, got_, want_); } while (0)
+#define CHECKI(op, a, i)     do { u128 got_ = spu_##op(a, i), want_ = spu_##op##_ref(a, i); \
+                                  if (!same(got_, want_)) report(#op, i, a, a, got_, want_); } while (0)
+
+int main(void)
+{
+#if !(defined(__AVX2__) && !defined(__ARM_NEON) && !defined(SPU_SCALAR_HELPERS))
+    puts("test_spu_float_est: no AVX2, nothing to compare");
+    return 0;
+#else
+    const long N = 2000000;
+    for (long it = 0; it < N; it++) {
+        u128 f, g, n;
+        for (int k = 0; k < 4; k++) { f._u32[k] = rnd_float(); g._u32[k] = rnd_float(); n._u32[k] = rnd_int(); }
+        CHECK1(frest, f);
+        CHECK1(frsqest, f);
+        CHECK2(fi, g, f);
+        CHECK2(fi, g, spu_frest_ref(f));               /* the frest -> fi pair as code uses it */
+        CHECK2(fi, g, spu_frsqest_ref(f));
+        const int imm = (int)(rnd32() & 0xFF);
+        CHECKI(cflts, f, imm);
+        CHECKI(cfltu, f, imm);
+        CHECKI(csflt, n, imm);
+        CHECKI(cuflt, n, imm);
+    }
+    /* every immediate on a fixed spread of operands */
+    for (int imm = 0; imm < 256; imm++)
+        for (int it = 0; it < 2000; it++) {
+            u128 f, n;
+            for (int k = 0; k < 4; k++) { f._u32[k] = rnd_float(); n._u32[k] = rnd_int(); }
+            CHECKI(cflts, f, imm); CHECKI(cfltu, f, imm); CHECKI(csflt, n, imm); CHECKI(cuflt, n, imm);
+        }
+    printf("test_spu_float_est: %ld mismatches\n", s_bad);
+
+    /* speed: the frest/fi reciprocal pair, vector vs scalar */
+    u128 x, y; for (int k = 0; k < 4; k++) { x._u32[k] = 0x3F800000u + rnd32() % 0x800000u; y = x; }
+    volatile uint32_t sink = 0;
+    const long R = 20000000;
+    clock_t t0 = clock();
+    for (long i = 0; i < R; i++) { x = spu_fi(y, spu_frest(x)); x._u32[0] ^= (uint32_t)i & 1u; }
+    sink += x._u32[0];
+    clock_t t1 = clock();
+    for (long i = 0; i < R; i++) { x = spu_fi_ref(y, spu_frest_ref(x)); x._u32[0] ^= (uint32_t)i & 1u; }
+    sink += x._u32[0];
+    clock_t t2 = clock();
+    printf("frest+fi: vector %.1f ns, scalar %.1f ns\n",
+           1e9 * (double)(t1 - t0) / CLOCKS_PER_SEC / R, 1e9 * (double)(t2 - t1) / CLOCKS_PER_SEC / R);
+    (void)sink;
+    return s_bad ? 1 : 0;
+#endif
+}
