+{
+    const u32 fmts[2] = { FMT_A8R8G8B8, FMT_D8R8G8B8 };
+    u8 src[64 * 4];
+    for (u32 i = 0; i < sizeof src; i++) src[i] = (u8)(i * 37u + 11u);
