+static void gcm_park_note(u32 io, u32 ea)
+{
+    if (!gcm_parklog() || io == s_park_io) return;
+    extern unsigned long long ps3_ms_now(void);
+    s_park_io = io; s_park_t0 = ps3_ms_now(); g_gcm_park_ea = ea;
+    static int n = 0;
+    if (n++ < 20000)
