+    { static u32 lo = 1, hi = 0;
+      if (lo == 1) { const char* e = getenv("GCM_WALK_REPORT"); lo = 0x1E000; hi = 0x20000;
+                     if (e) { char* p; lo = (u32)strtoul(e, &p, 16); if (p && *p == '-') hi = (u32)strtoul(p + 1, 0, 16); } }
