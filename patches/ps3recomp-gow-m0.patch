+        if (e) { tmask = (uint8_t*)calloc(0x800000 / 4 / 8, 1);
+            while (*e) { char* p = nullptr; uint32_t lo = (uint32_t)strtoul(e, &p, 16), hi = lo;
+                if (p && *p == '-') hi = (uint32_t)strtoul(p + 1, &p, 16);
+                for (uint32_t a = lo; a <= hi && a < 0x800000; a += 4) tmask[(a >> 2) >> 3] |= 1u << ((a >> 2) & 7);
