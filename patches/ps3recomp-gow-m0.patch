+static int fails;
+static void check(int ok, const char* what)
+{
+    printf("[%s] %s\n", ok ? "PASS" : "FAIL", what);
+    fails += !ok;
+}
+
+/* One method, count 1, subchannel 0. */
+static u32 put_probe(u32 io, u32 arg)
+{
+    gw32(IO_ADDR + io, (1u << 18) | PROBE_METHOD);
+    gw32(IO_ADDR + io + 4, arg);
+    return io + 8;
+}
