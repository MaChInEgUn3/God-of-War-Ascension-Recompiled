+/*
+ * ps3recomp - buffered host stdout/stderr, flushed on a timer and on the way out
+ * (see ps3_stdio.h for why)
+ *
+ * Win32-shaped on purpose: on Windows this is the real API, elsewhere it is
+ * win32_compat.h, whose SetUnhandledExceptionFilter is called from the same
+ * SIGSEGV/SIGBUS/SIGILL/SIGFPE dispatcher as the runtime's vectored handlers.
+ * A fault one of those handlers resolves (demand commit, the guard pages) never
+ * reaches the filter, so the crash flush runs only for a real crash.
+ *
+ * Atomics are the __atomic builtins, as in win32_compat.h and milestone.c.
+ */
+#include "ps3_stdio.h"
+#include "win32_compat.h"
+
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define PS3_STDIO_BUF_BYTES        (64u * 1024u)
+#define PS3_STDIO_FLUSH_MS_DEFAULT 50u
+#define PS3_STDIO_FLUSH_MS_MAX     10000u
+#define PS3_STDIO_CRASH_WAIT_MS    1000u
+
+static char s_out_buf[PS3_STDIO_BUF_BYTES];
+static char s_err_buf[PS3_STDIO_BUF_BYTES];
+
+static int      s_init_done;            /* first ps3_stdio_init() call wins */
+static int      s_buffered;             /* the flush thread is running */
+static int      s_stop;                 /* exit has begun: the thread stops flushing */
+static unsigned s_flush_ms = PS3_STDIO_FLUSH_MS_DEFAULT;
+static HANDLE   s_wake;                 /* auto-reset: a crash flush wakes the thread early */
+static long     s_flush_req;            /* crash flushes asked for */
+static long     s_flush_done;           /* value of s_flush_req the last flush covered */
+
+static LPTOP_LEVEL_EXCEPTION_FILTER s_prev_filter;
+static void (*s_prev_abort)(int);
+
+static DWORD WINAPI ps3_stdio_flusher(LPVOID arg)
+{
+    (void)arg;
+    for (;;) {
+        WaitForSingleObject(s_wake, s_flush_ms);
+        if (__atomic_load_n(&s_stop, __ATOMIC_ACQUIRE)) return 0;
+        long want = __atomic_load_n(&s_flush_req, __ATOMIC_ACQUIRE);
+        fflush(stdout);
+        fflush(stderr);
+        __atomic_store_n(&s_flush_done, want, __ATOMIC_RELEASE);
+    }
+}
+
+void ps3_stdio_flush(void)
+{
+    fflush(stdout);
+    fflush(stderr);
+}
+
+void ps3_stdio_flush_crash(void)
+{
+    if (!__atomic_load_n(&s_buffered, __ATOMIC_ACQUIRE)) return;   /* nothing buffered */
+    if (__atomic_load_n(&s_stop, __ATOMIC_ACQUIRE)) return;        /* exit is flushing */
+    long want = __atomic_add_fetch(&s_flush_req, 1, __ATOMIC_ACQ_REL);
+    SetEvent(s_wake);
+    for (unsigned waited = 0; waited < PS3_STDIO_CRASH_WAIT_MS; waited += 5) {
+        if (__atomic_load_n(&s_flush_done, __ATOMIC_ACQUIRE) >= want) return;
+        Sleep(5);
+    }
+}
+
+static void ps3_stdio_at_exit(void)
+{
+    __atomic_store_n(&s_stop, 1, __ATOMIC_RELEASE);
+    ps3_stdio_flush();
+}
+
+/* abort(): flush, then whatever was installed before. Returning lets abort()
+ * end the process as it would have. */
+static void ps3_stdio_on_abort(int sig)
+{
+    ps3_stdio_flush_crash();
+    if (s_prev_abort && s_prev_abort != SIG_DFL && s_prev_abort != SIG_IGN)
+        s_prev_abort(sig);
+}
+
+/* A crash: flush what the run printed before it, let the previous filter
+ * report, then flush its report too (unless it resolved the exception). */
+static LONG WINAPI ps3_stdio_on_crash(EXCEPTION_POINTERS* ep)
+{
+    ps3_stdio_flush_crash();
+    LONG r = s_prev_filter ? s_prev_filter(ep) : EXCEPTION_CONTINUE_SEARCH;
+    if (r != EXCEPTION_CONTINUE_EXECUTION) ps3_stdio_flush_crash();
+    return r;
+}
+
+static unsigned ps3_stdio_env_ms(const char* name, unsigned def)
+{
+    const char* s = getenv(name);
+    if (!s || !*s) return def;
+    char* end = NULL;
+    unsigned long v = strtoul(s, &end, 10);
+    if (*end || v < 1 || v > PS3_STDIO_FLUSH_MS_MAX) {
+        fprintf(stderr, "[stdio] %s=%s ignored (1..%u), using %u\n",
+                name, s, PS3_STDIO_FLUSH_MS_MAX, def);
+        return def;
+    }
+    return (unsigned)v;
+}
+
+void ps3_stdio_init(void)
+{
+    if (__atomic_exchange_n(&s_init_done, 1, __ATOMIC_ACQ_REL)) return;
+
+    const char* unbuf = getenv("PS3_STDIO_UNBUFFERED");
+    if (unbuf && unbuf[0] == '1') {
+        setvbuf(stdout, NULL, _IONBF, 0);
+        return;
+    }
+
+    s_flush_ms = ps3_stdio_env_ms("PS3_STDIO_FLUSH_MS", PS3_STDIO_FLUSH_MS_DEFAULT);
+    s_wake = CreateEventA(NULL, FALSE, FALSE, NULL);
+    if (!s_wake) { setvbuf(stdout, NULL, _IONBF, 0); return; }
+
+    /* setvbuf on a stream that has been written to: flush first, which is
+     * what the C libraries this builds against need to switch modes cleanly
+     * (the old _IONBF call here relied on the same). */
+    fflush(stdout);
+    fflush(stderr);
+    setvbuf(stdout, s_out_buf, _IOFBF, sizeof s_out_buf);
+    setvbuf(stderr, s_err_buf, _IOFBF, sizeof s_err_buf);
+
+    HANDLE t = CreateThread(NULL, 0, ps3_stdio_flusher, NULL, 0, NULL);
+    if (!t) {
+        setvbuf(stdout, NULL, _IONBF, 0);
+        setvbuf(stderr, NULL, _IONBF, 0);
+        fprintf(stderr, "[stdio] flush thread failed to start; stdout/stderr unbuffered\n");
+        return;
+    }
+    CloseHandle(t);
+    __atomic_store_n(&s_buffered, 1, __ATOMIC_RELEASE);
+
+    atexit(ps3_stdio_at_exit);
+    void (*prev)(int) = signal(SIGABRT, ps3_stdio_on_abort);
+    s_prev_abort = (prev == SIG_ERR) ? NULL : prev;
+    s_prev_filter = SetUnhandledExceptionFilter(ps3_stdio_on_crash);
+
+    fprintf(stderr, "[stdio] stdout/stderr buffered (%u KB each), flushed every %u ms"
+                    " (PS3_STDIO_UNBUFFERED=1: unbuffered)\n",
+            PS3_STDIO_BUF_BYTES / 1024u, s_flush_ms);
+}
diff --git a/runtime/platform/ps3_stdio.h b/runtime/platform/ps3_stdio.h
new file mode 100644
index 00000000..125835bd
--- /dev/null
+++ b/runtime/platform/ps3_stdio.h
@@ -0,0 +1,60 @@
+/*
+ * ps3recomp - buffered host stdout/stderr, flushed on a timer and on the way out
+ *
+ * The runtime logs a lot: HLE calls, syscalls, SPU dispatch, from every guest
+ * thread. That output used to go through an unbuffered stdout (ppu_run set
+ * _IONBF), so that a run killed from outside still left every line it printed
+ * -- "the log line is absent" has to be usable as evidence.
+ *
+ * Unbuffered is expensive where it matters most. mingw-w64's printf
+ * (__mingw_pformat) hands an unbuffered FILE one character at a time, so each
+ * character becomes its own write(); under Wine into a pipe that is
+ * microseconds per character, and a title that logs a thousand lines a second
+ * spends most of its logging threads' time there. Lines from two threads also
+ * interleave character by character.
+ *
+ * ps3_stdio_init() keeps the evidence and drops the cost: stdout and stderr
+ * get a 64 KB buffer each (full buffering), and a small thread flushes both
+ * every PS3_STDIO_FLUSH_MS milliseconds (default 50). They are also flushed at
+ * exit (atexit), on abort() (SIGABRT), and when an exception reaches the
+ * unhandled-exception filter (a crash; on POSIX through win32_compat's
+ * dispatcher). A run killed with no chance to clean up loses at most the last
+ * flush interval.
+ *
+ * PS3_STDIO_UNBUFFERED=1 keeps the old behaviour: stdout unbuffered, stderr
+ * left as the C library set it, no thread. Use it when the exact order of
+ * stdout and stderr lines in one merged stream matters: buffered, each
+ * stream's lines stay in order, but within one flush interval a stdout line
+ * and a stderr line can come out in either order.
+ *
+ * ppu_run() calls ps3_stdio_init(). A host may call it earlier itself, to
+ * cover its own startup output; later calls do nothing.
+ */
+#ifndef PS3_STDIO_H
+#define PS3_STDIO_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Buffer stdout and stderr and start the flush thread (see above). Idempotent.
+ * Falls back to the old behaviour (stdout unbuffered) if the thread cannot be
+ * started. */
+void ps3_stdio_init(void);
+
+/* Flush stdout and stderr now, from the calling thread. For normal paths. */
+void ps3_stdio_flush(void);
+
+/* Flush from a crash or abort path: asks the flush thread to flush and waits
+ * for it, at most about a second. The calling thread may have died holding a
+ * stream's lock (a fault inside printf), and fflush from that thread would
+ * then never return; the flush thread may block on that lock instead, and the
+ * caller carries on after the timeout. A host with its own crash handler that
+ * ends the process (ExitProcess, _exit) calls this first. */
+void ps3_stdio_flush_crash(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3_STDIO_H */
diff --git a/runtime/platform/tests/test_stdio_flush.c b/runtime/platform/tests/test_stdio_flush.c
new file mode 100644
index 00000000..b9d193b1
--- /dev/null
+++ b/runtime/platform/tests/test_stdio_flush.c
@@ -0,0 +1,242 @@
+/*
+ * ps3recomp - test for runtime/platform/ps3_stdio.c (buffered stdout/stderr
+ * with a timed flush)
+ *
+ * Each case runs in a forked child whose stdout and stderr are pipes the
+ * parent reads, because what is being checked is when bytes reach the file
+ * descriptor, which only an outside reader can see:
+ *
+ *   - buffered by default: right after a printf, nothing has reached the pipe
+ *     (the interval is 5 s here, so the timer cannot have fired yet);
+ *   - flushed within the interval: with PS3_STDIO_FLUSH_MS=50 a line arrives
+ *     while the child is still alive and blocked, so it came from the timer,
+ *     not from exit;
+ *   - flushed at exit, on abort() and on a crash (a SIGSEGV that reaches the
+ *     unhandled-exception filter through win32_compat's dispatcher), each
+ *     with the 5 s interval, so the timer is not what delivered it;
+ *   - PS3_STDIO_UNBUFFERED=1: a line is in the pipe as soon as printf returns.
+ *
+ * Build (any POSIX host):
+ *   cc -std=gnu17 -Wall -Wextra -I runtime/platform -o test_stdio_flush \
+ *      runtime/platform/tests/test_stdio_flush.c runtime/platform/ps3_stdio.c \
+ *      runtime/platform/win32_compat.c -lpthread
+ *
+ * Exit status is the number of failed checks, so it works as a CI step.
+ */
+#if defined(__linux__) && !defined(_GNU_SOURCE)
+#  define _GNU_SOURCE
+#endif
+#include "../ps3_stdio.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+static int g_pass, g_fail;
+#define CHECK(cond) do { if (cond) g_pass++; else { g_fail++; \
+    fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); } } while (0)
+
+enum { END_EXIT, END_ABORT, END_CRASH, END_WAIT };
+
+/* Volatile so the compiler cannot see the store is to a fixed bad address. */
+static volatile uintptr_t g_bad_addr = 8;
+
+typedef struct {
+    pid_t pid;
+    int   out, err;   /* read ends of the child's stdout and stderr */
+    int   ctl_in;     /* child -> parent: one byte after it printed */
+    int   ctl_out;    /* parent -> child: one byte to let it finish */
+} child_t;
+
+static double now_ms(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+}
+
+/* The child: set the environment, init, print one line to each stream, tell
+ * the parent, then end the way the case asks. */
+static void child_main(int ctl_w, int ctl_r, const char* flush_ms, int unbuffered, int end)
+{
+    if (flush_ms) setenv("PS3_STDIO_FLUSH_MS", flush_ms, 1); else unsetenv("PS3_STDIO_FLUSH_MS");
+    if (unbuffered) setenv("PS3_STDIO_UNBUFFERED", "1", 1); else unsetenv("PS3_STDIO_UNBUFFERED");
+    ps3_stdio_init();
+    /* The init banner goes to stderr; get it out of the way so the parent's
+     * "nothing yet" check is about the line printed below. */
+    fflush(stderr);
+    if (write(ctl_w, "i", 1) != 1) _exit(90);
+    { char c; if (read(ctl_r, &c, 1) != 1) _exit(91); }
+
+    printf("out-line\n");
+    fprintf(stderr, "err-line\n");
+    if (write(ctl_w, "p", 1) != 1) _exit(92);
+
+    switch (end) {
+    case END_EXIT:  exit(0);
+    case END_ABORT: abort();
+    case END_CRASH: *(volatile int*)g_bad_addr = 1; _exit(93);
+    case END_WAIT:  { char c; if (read(ctl_r, &c, 1) != 1) _exit(94); exit(0); }
+    }
+    _exit(95);
+}
+
+static child_t spawn(const char* flush_ms, int unbuffered, int end)
+{
+    int o[2], e[2], up[2], down[2];
+    if (pipe(o) || pipe(e) || pipe(up) || pipe(down)) { perror("pipe"); exit(100); }
+    fflush(stdout); fflush(stderr);
+    pid_t pid = fork();
+    if (pid < 0) { perror("fork"); exit(100); }
+    if (pid == 0) {
+        dup2(o[1], 1); dup2(e[1], 2);
+        close(o[0]); close(o[1]); close(e[0]); close(e[1]);
+        close(up[0]); close(down[1]);
+        child_main(up[1], down[0], flush_ms, unbuffered, end);
+    }
+    close(o[1]); close(e[1]); close(up[1]); close(down[0]);
+    fcntl(o[0], F_SETFL, O_NONBLOCK);
+    fcntl(e[0], F_SETFL, O_NONBLOCK);
+    child_t c = { pid, o[0], e[0], up[0], down[1] };
+    return c;
+}
+
+static void wait_byte(int fd)
+{
+    char c;
+    CHECK(read(fd, &c, 1) == 1);
+}
+
+/* Append whatever is in fd now to buf (no waiting). Returns 1 on EOF. */
+static int drain(int fd, char* buf, size_t cap)
+{
+    size_t len = strlen(buf);
+    for (;;) {
+        if (len + 1 >= cap) return 0;
+        ssize_t n = read(fd, buf + len, cap - 1 - len);
+        if (n > 0) { len += (size_t)n; buf[len] = 0; continue; }
+        if (n == 0) return 1;
+        return 0;   /* EAGAIN */
+    }
+}
+
+/* Wait up to ms for needle to show up in fd. */
+static int wait_for(int fd, char* buf, size_t cap, const char* needle, double ms)
+{
+    double end = now_ms() + ms;
+    for (;;) {
+        int eof = drain(fd, buf, cap);
+        if (strstr(buf, needle)) return 1;
+        if (eof) return 0;
+        double left = end - now_ms();
+        if (left <= 0) return 0;
+        struct pollfd p = { fd, POLLIN, 0 };
+        poll(&p, 1, (int)(left < 20 ? left + 1 : 20));
+    }
+}
+
+static int finish(child_t* c)
+{
+    int st = 0;
+    if (write(c->ctl_out, "x", 1) != 1) { /* the child may be gone already */ }
+    waitpid(c->pid, &st, 0);
+    close(c->out); close(c->err); close(c->ctl_in); close(c->ctl_out);
+    return st;
+}
+
+/* Start a child, let it init and print, and return with the line printed. */
+static child_t start(const char* flush_ms, int unbuffered, int end)
+{
+    child_t c = spawn(flush_ms, unbuffered, end);
+    wait_byte(c.ctl_in);                         /* initialised */
+    { char junk[512] = ""; drain(c.err, junk, sizeof junk); }   /* the banner */
+    CHECK(write(c.ctl_out, "g", 1) == 1);
+    wait_byte(c.ctl_in);                         /* printed */
+    return c;
+}
+
+static void test_buffered_by_default(void)
+{
+    child_t c = start("5000", 0, END_WAIT);
+    char out[256] = "", err[256] = "";
+    drain(c.out, out, sizeof out);
+    drain(c.err, err, sizeof err);
+    CHECK(strstr(out, "out-line") == NULL);      /* still in the stdout buffer */
+    CHECK(strstr(err, "err-line") == NULL);      /* still in the stderr buffer */
+    int st = finish(&c);
+    CHECK(WIFEXITED(st) && WEXITSTATUS(st) == 0);
+}
+
+static void test_flushed_within_interval(void)
+{
+    child_t c = start("50", 0, END_WAIT);
+    double t0 = now_ms();
+    char out[256] = "", err[256] = "";
+    /* 50 ms interval; 2 s allows for a loaded CI runner. The child is blocked
+     * on its control pipe the whole time, so only the timer can deliver. */
+    CHECK(wait_for(c.out, out, sizeof out, "out-line\n", 2000));
+    CHECK(wait_for(c.err, err, sizeof err, "err-line\n", 2000));
+    double took = now_ms() - t0;
+    CHECK(kill(c.pid, 0) == 0);                  /* still alive: not an exit flush */
+    int st = finish(&c);
+    CHECK(WIFEXITED(st) && WEXITSTATUS(st) == 0);
+    printf("  timed flush: both lines arrived %.0f ms after printing (interval 50 ms)\n", took);
+}
+
+static void test_end(int end, const char* what, int want_sig)
+{
+    child_t c = start("5000", 0, end);
+    char out[256] = "", err[512] = "";
+    double t0 = now_ms();
+    int st = 0;
+    waitpid(c.pid, &st, 0);
+    double took = now_ms() - t0;
+    drain(c.out, out, sizeof out);
+    drain(c.err, err, sizeof err);
+    int ok = strstr(out, "out-line\n") && strstr(err, "err-line\n");
+    if (!ok) fprintf(stderr, "  %s: stdout=\"%s\" stderr=\"%s\"\n", what, out, err);
+    CHECK(strstr(out, "out-line\n") != NULL);
+    CHECK(strstr(err, "err-line\n") != NULL);
+    CHECK(took < 4000);                          /* not the 5 s timer */
+    /* A crash may end in SIGSEGV or SIGBUS depending on the host (see
+     * test_guest_ptr_trap.c); either is the fault, not some other death. */
+    if (want_sig == SIGSEGV)
+        CHECK(WIFSIGNALED(st) && (WTERMSIG(st) == SIGSEGV || WTERMSIG(st) == SIGBUS));
+    else if (want_sig) CHECK(WIFSIGNALED(st) && WTERMSIG(st) == want_sig);
+    else          CHECK(WIFEXITED(st) && WEXITSTATUS(st) == 0);
+    close(c.out); close(c.err); close(c.ctl_in); close(c.ctl_out);
+    if (ok) printf("  %s: both lines delivered, child ended in %.0f ms\n", what, took);
+}
+
+static void test_unbuffered_env(void)
+{
+    child_t c = start("5000", 1, END_WAIT);
+    char out[256] = "", err[256] = "";
+    drain(c.out, out, sizeof out);
+    drain(c.err, err, sizeof err);
+    CHECK(strstr(out, "out-line\n") != NULL);    /* there as soon as printf returned */
+    CHECK(strstr(err, "err-line\n") != NULL);    /* stderr stays unbuffered too */
+    int st = finish(&c);
+    CHECK(WIFEXITED(st) && WEXITSTATUS(st) == 0);
+}
+
+int main(void)
+{
+    signal(SIGPIPE, SIG_IGN);
+    test_buffered_by_default();
+    test_flushed_within_interval();
+    test_end(END_EXIT,  "exit()",  0);
+    test_end(END_ABORT, "abort()", SIGABRT);
+    test_end(END_CRASH, "SIGSEGV", SIGSEGV);
+    test_unbuffered_env();
+    printf("test_stdio_flush: %d passed, %d failed\n", g_pass, g_fail);
+    return g_fail;
+}
