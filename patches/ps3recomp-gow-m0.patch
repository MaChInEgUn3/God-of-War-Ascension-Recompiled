+static void gcm_dump_memtable(const char* tag)
+{
+    static u32 base = 0xFFFFFFFFu;
+    if (base == 0xFFFFFFFFu) { const char* e = getenv("GCM_MEMTABLE"); base = e ? (u32)strtoul(e, NULL, 16) : 0; }
+    if (!base) return;
+    u32 count = vm_read32(base + 0x80);
+    printf("[memtable] %s count=%u:", tag, count);
+    for (u32 i = 1; i < count && i < 24; i++) {
+        u32 w = vm_read32(base + 4 * i);
+        printf(" [%u]key=%03X sz=%u io=%u fl=%u", i, w >> 20, (w >> 11) & 0x1FF, (w >> 2) & 0x1FF, w & 3);
+    }
+    /* GoW Ascension: the pool base the mapped-memory allocator got from
+     * sys_mmapper_allocate_address (global at 0x81AB68). */
+    printf(" | pool@81AB68=%08X", vm_read32(0x81AB68));
+    { u32 cfg = vm_read32(0x81A6EC);   /* GoW: memory budget config object */
+      u32 tab = vm_read32(cfg + 0x1DC), cnt = vm_read32(cfg + 0x1E0);
+      printf("\n  budgetcfg@%08X tab=%08X cnt=%u d8=%08X:", cfg, tab, cnt, vm_read32(cfg + 0x1D8));
+      for (u32 i = 0; i < cnt && i < 24; i++) {
+          u32 e = tab + 0xC8 * i, p = vm_read32(e + 0x74);
+          printf(" [%u]h=%08X sz@74=%08X(%08X)", i, vm_read32(e + 4), p, p ? vm_read32(p) : 0);
+      } }
+    printf("\n  mem@12B90A60:");
+    for (u32 o = 0; o < 0x40; o += 4) printf(" %08X", vm_read32(0x12B90A60 + o));
+    printf("\n  mem@22B90A60:");
+    for (u32 o = 0; o < 0x40; o += 4) printf(" %08X", vm_read32(0x22B90A60 + o));
+    printf("\n  resource slot @997520:");
+    for (u32 o = 0; o < 0x40; o += 4) printf(" %08X", vm_read32(0x997520 + o));
+    { u32 d = vm_read32(0x81AB64);
+      printf(" | desc@81AB64=%08X [+4=%u +8=%u +C=%u] g8AFDD8..E4=%u,%u,%u,%u g9816A0=%08X",
+             d, vm_read32(d + 4), vm_read32(d + 8), vm_read32(d + 0xC),
+             vm_read32(0x8AFDD8), vm_read32(0x8AFDDC), vm_read32(0x8AFDE0), vm_read32(0x8AFDE4),
+             vm_read32(0x9816A0)); }
+    /* GoW Ascension allocator list (head at 0x82A80C, next at +0xC): tag, range
+     * fields and, for the mapped-page allocator (tag 0x2D1E4), base/pages. */
+    { u32 node = vm_read32(0x82A80C);
+      for (int k = 0; node && k < 12; k++, node = vm_read32(node + 0xC)) {
+          u32 tag = vm_read32(node);
+          if (tag == 0x2D1E4)
+          {
+              printf("\n  alloc[%d] %08X tag=2D1E4 base(+10)=%08X pages(+1C50)=%u count(+1C44)=%u b2(+1C48)=%08X",
+                     k, node, vm_read32(node + 0x10), vm_read32(node + 0x1C50), vm_read32(node + 0x1C44), vm_read32(node + 0x1C48));
+              /* page records {+0x44 .., handle@+0x48, key@+0x4C}, stride 0xC: print
+               * the distinct keys with their page counts. */
+              u32 n = vm_read32(node + 0x1C44), keys[16], cnt[16], nk = 0;
+              for (u32 i = 0; i < n && i < 512; i++) {
+                  u32 h = vm_read32(node + 0x48 + 12 * i), key = vm_read32(node + 0x4C + 12 * i);
+                  if (!h) continue;
+                  u32 j = 0; while (j < nk && keys[j] != key) j++;
+                  if (j == nk && nk < 16) { keys[nk] = key; cnt[nk] = 0; nk++; }
+                  if (j < nk) cnt[j]++;
+              }
+              printf("\n    page-record keys:");
+              for (u32 j = 0; j < nk; j++) printf(" %08X x%u", keys[j], cnt[j]);
+          }
+          else
+              printf("\n  alloc[%d] %08X tag=%08X lo(+10)=%08X hi(+18)=%08X", k, node, tag, vm_read32(node + 0x10), vm_read32(node + 0x18));
+      } }
+    printf("\n");
+}
