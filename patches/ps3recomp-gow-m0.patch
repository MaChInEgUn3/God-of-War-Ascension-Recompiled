+/* ---- the vertex-program hash memo ---------------------------------------- */
+
+/* One instruction, MOV o0 = v0.swz, uploaded at `slot` and started there. */
+static void load_vp_mov(u32 swz, u32 slot)
+{
+    u8 vp[16];
+    rsx_test_vp_mov_out(vp, 0, swz, 0, 1);
+    m(0x1E9C, slot);                                   /* VP_UPLOAD_FROM_ID */
+    for (u32 i = 0; i < 4; i++) { u32 w; memcpy(&w, vp + i * 4, 4); m(0x0B80 + i * 4, w); }
+    m(0x1EA0, slot);                                   /* VP_START_FROM_ID */
+}
+
+/* The pipeline key holds the vertex program's bytes, now remembered by
+ * content: every program must still get its own pipeline, a re-upload of an
+ * earlier one (in place or at another slot) its old one, and a word patched
+ * in place a new one -- the same answers with the memo on and off, past the
+ * memo's capacity. */
+static void test_vp_hash_memo(int fast)
+{
+    printf("-- vertex program hash memo (%s)\n", fast ? "on" : "off");
+    rsx_draw_engine_set_walker_fast(fast);
+    engine_up();
+    rsx_test_fp_mov_r0_col0(vm_base + TEX_OFFSET, RSX_TEST_FP_SWZ_IDENT);
+    m(0x08E4, TEX_OFFSET | 2u);                        /* SHADER_PROGRAM, main */
+    m(0x1D60, 64u);                                    /* SHADER_CONTROL */
+
+    enum { NV = 24 };                                  /* more than the memo holds */
+    u32 handle[NV];
+    for (u32 i = 0; i < NV; i++) {
+        load_vp_mov(RSX_TEST_VP_SWZ(i & 3, (i >> 2) & 3, (i >> 4) & 3, 3), 0);
+        draw_triangle();
+        handle[i] = stub.bound_pipeline;
+    }
+    CHECK(stub.n_pipeline_create == NV && stub.n_draw == NV,
+          "each of %d programs gets a pipeline of its own (%d built, %d drawn)",
+          NV, stub.n_pipeline_create, stub.n_draw);
+    int distinct = 1;
+    for (u32 i = 0; i < NV; i++)
+        for (u32 k = 0; k < i; k++) distinct &= handle[i] != handle[k];
+    CHECK(distinct, "and no two programs share one");
+
+    int same = 1;
+    for (u32 n = 0; n < 3 * NV; n++) {
+        const u32 i = (n * 7u + 3u) % NV;
+        load_vp_mov(RSX_TEST_VP_SWZ(i & 3, (i >> 2) & 3, (i >> 4) & 3, 3), (n & 1) ? 0u : 8u);
+        draw_triangle();
+        same &= stub.bound_pipeline == handle[i];
+    }
+    CHECK(same && stub.n_pipeline_create == NV,
+          "re-uploading any of them, in place or at another slot, finds its pipeline (%d built)",
+          stub.n_pipeline_create);
+
+    /* One word of the program in place changes, nothing else does. */
+    load_vp_mov(RSX_TEST_VP_SWZ(0, 1, 0, 3), 0);       /* program 4 */
+    draw_triangle();
+    const u32 before = stub.bound_pipeline;
+    CHECK(before == handle[4] && stub.n_pipeline_create == NV, "program 4 again is pipeline 4");
+    m(0x1E9C, 0);
+    { u8 vp[16]; u32 w; rsx_test_vp_mov_out(vp, 0, RSX_TEST_VP_SWZ(3, 2, 1, 0), 0, 1);
+      for (u32 i = 0; i < 4; i++) { memcpy(&w, vp + i * 4, 4); m(0x0B80 + i * 4, w); } }
+    draw_triangle();
+    CHECK(stub.bound_pipeline != before && stub.n_pipeline_create == NV + 1,
+          "a program rewritten in place at the same start is a new pipeline (%d built)",
+          stub.n_pipeline_create);
+    engine_down();
+    rsx_draw_engine_set_walker_fast(-1);
+}
