+    if (limit < 0) { const char* e = getenv("PPU_TRACE_MAX"); limit = e ? atol(e) : 4000; }
+    if (n >= limit) return;
+    n++;
+    fprintf(stderr, "[FN %08X] tid=%llu r3=%08X r4=%08X r5=%08X r6=%08X r7=%08X lr=%08X sp=%08X\n",
+            addr, (unsigned long long)ctx->thread_id, (uint32_t)ctx->gpr[3], (uint32_t)ctx->gpr[4],
+            (uint32_t)ctx->gpr[5], (uint32_t)ctx->gpr[6], (uint32_t)ctx->gpr[7],
+            (uint32_t)ctx->lr, (uint32_t)ctx->gpr[1]);
