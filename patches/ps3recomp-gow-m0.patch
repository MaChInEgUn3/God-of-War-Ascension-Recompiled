+    static const u32 big_sentinel_tris[] = { 3, 1, 2 };
+    indexed_case(big_sentinel_tris, 3, 0, 1, 0x10002u, RSX_PRIMITIVE_TRIANGLES, big_sentinel_tris, 3,
