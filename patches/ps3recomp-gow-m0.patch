+          long k = InterlockedIncrement(&s_sput_i) % GCM_SPUPUT_N;
+          s_sput[k].io = io; s_sput[k].size = size; s_sput[k].pc = pc; s_sput[k].img = img; s_sput[k].wid = wid;
+          s_sput[k].w0 = (u32)src[0] << 24 | (u32)src[1] << 16 | (u32)src[2] << 8 | src[3];
+          s_sput[k].t = ps3_ms_now();
+      } }
+    for (int k = 0; k < GCM_KICK_N; k++) {
+        const u32 ke = s_kick_ea[k];
+        if (!ke || ea > ke || ea + size < ke + 4u) continue;
+        const uint8_t* d = src + (ke - ea);
+        const u32 w = (u32)d[0] << 24 | (u32)d[1] << 16 | (u32)d[2] << 8 | d[3];
+        if (w != (0x20000000u | s_kick_io[k])) continue;
+        extern unsigned long long ps3_ms_now(void);
+        static volatile long n = 0;
+        if (InterlockedIncrement(&n) <= 400)
+            fprintf(stderr, "[park-reset] SPU img=%d wid=%u pc=0x%05X cmd=0x%02X ea=0x%08X size=0x%X re-parks io=0x%08X released %llu ms ago\n",
+                    img, wid, pc, cmd, ea, size, s_kick_io[k], ps3_ms_now() - s_kick_t[k]);
+    }
