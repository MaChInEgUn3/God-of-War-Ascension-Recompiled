+/* Scan the live guest stack for specific 32-bit values (comma-separated hex) and
+ * print where they sit relative to r1, plus the callee-saved registers. Used to
+ * find which frame a bad argument originated in: the deepest frame that holds
+ * the value is where it entered the call chain. */
+extern "C" void ppu_guest_scan_stack(const char* tag, const char* values)
+{
+    if (!g_active_ctx || !values) return;
+    uint32_t want[8]; int nw = 0;
+    for (const char* p = values; *p && nw < 8; ) {
+        char* e = nullptr; unsigned long v = strtoul(p, &e, 16);
+        if (e == p) break;
+        want[nw++] = (uint32_t)v;
+        p = (*e == ',') ? e + 1 : e;
