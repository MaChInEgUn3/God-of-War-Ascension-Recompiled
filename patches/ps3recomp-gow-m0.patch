+/* Guest function-entry tracer (PPU_TRACE_FUNCS at lift time): logs the argument
+ * registers, caller and thread on entry. PPU_TRACE_MAX caps the output (default
+ * 4000 lines); PPU_TRACE_REGS=1 adds r11..r14 and the callee-saved r27..r31. */
+void ppu_trace_enter(uint32_t addr, ppu_context* ctx)   /* declared in ppu_recomp.h */
+{
+    /* A PPU_TRACE_FUNCS=all lift calls this on every guest function entry (5% of
+     * GoW:A's main thread in a profile). Once the first call has seen that only
+     * the PPU_TRACE_ADDRS filter or the line cap can still act, reject here. */
+    static int s_extras = -1;              /* DESC_CHECK, DELAY_FN or TRACE_DUMP(2) set */
+    static uint8_t* tmask = nullptr; static int tinit = 0;
+    static long limit = -1; static long n = 0;
+    if (s_extras == 0 && (tmask ? !(addr < 0x800000 && (tmask[(addr >> 2) >> 3] >> ((addr >> 2) & 7) & 1))
+                                : n >= limit))
+        return;
+    if (s_extras < 0)
+        s_extras = (getenv("PPU_DESC_CHECK") || getenv("PPU_DELAY_FN") || getenv("PPU_TRACE_DUMP") ||
+                    getenv("PPU_TRACE_DUMP2")) ? 1 : 0;
+    /* PPU_TRACE_ADDRS=<hex>[-<hex>],... : run-time filter for a build lifted with PPU_TRACE_FUNCS=all.
+     * Unset = trace every function the lifter instrumented. Code is below 0x800000. */
+    /* PPU_DESC_CHECK=<fn>,<table ea>,<count ea>,<limit>: on every entry to fn, walk
+     * the count ([count ea]) big-endian pointers at table ea; each points at a block
+     * descriptor {+8 offset, +0xC size}. Report a descriptor that ends past
+     * limit (sizes are raw bytes, not rounded) -- the frame the allocator's books
+     * went wrong, long before its own copy check trips. Once per descriptor. */
+    { static uint32_t s_dfn2 = 1, s_dtab, s_dcnt, s_dlim;
+      if (s_dfn2 == 1) { s_dfn2 = 0; const char* e = getenv("PPU_DESC_CHECK");
+          if (e && *e) { char* p; s_dfn2 = (uint32_t)strtoul(e, &p, 16);
+              if (*p == ',') s_dtab = (uint32_t)strtoul(p + 1, &p, 16);
+              if (*p == ',') s_dcnt = (uint32_t)strtoul(p + 1, &p, 16);
+              if (*p == ',') s_dlim = (uint32_t)strtoul(p + 1, &p, 16); } }
+      if (s_dfn2 && addr == s_dfn2 && s_dtab && s_dcnt) {
+          uint32_t n = vm_read32(s_dcnt); if (n > 0x4000) n = 0x4000;
+          static uint32_t said[16]; static int nsaid = 0;
+          for (uint32_t i = 0; i < n; i++) {
+              uint32_t d = vm_read32(s_dtab + i * 4);
+              if (!d || d >= 0x40000000u) continue;
+              uint32_t off = vm_read32(d + 8), sz = vm_read32(d + 0xC);
+              if (!s_dlim || ((uint64_t)off + sz <= s_dlim)) continue;
+              int k = 0; for (; k < nsaid; k++) if (said[k] == d) break;
+              if (k < nsaid || nsaid >= 16) continue;
+              said[nsaid++] = d;
+              fprintf(stderr, "[DESC] bad #%u at 0x%08X tid=%llu lr=%08X: off=%08X size=%08X |", i, d,
+                      (unsigned long long)ctx->thread_id, (uint32_t)ctx->lr, off, sz);
+              for (uint32_t o = 0; o < 0x20; o += 4) fprintf(stderr, " %08X", vm_read32(d + o));
+              fprintf(stderr, "\n");
+          } } }
+    if (!tinit) { tinit = 1; const char* e = getenv("PPU_TRACE_ADDRS");
+        if (e) { tmask = (uint8_t*)calloc(0x800000 / 4 / 8, 1);
+            while (*e) { char* p = nullptr; uint32_t lo = (uint32_t)strtoul(e, &p, 16), hi = lo;
+                if (p && *p == '-') hi = (uint32_t)strtoul(p + 1, &p, 16);
+                for (uint32_t a = lo; a <= hi && a < 0x800000; a += 4) tmask[(a >> 2) >> 3] |= 1u << ((a >> 2) & 7);
+                if (!p || p == e) break; e = p; while (*e == ',') e++; } } }
+    /* PPU_DELAY_FN=<hex fn>,<ms>: sleep ms on every entry to fn (timing experiments: slow one
+     * guest loop, e.g. the frame function, against the SPU/RSX side). Needs a PPU_TRACE_FUNCS=all lift. */
+    { static uint32_t s_dfn = 1, s_dms = 0;
+      if (s_dfn == 1) { s_dfn = 0; const char* e = getenv("PPU_DELAY_FN");
+          if (e) { char* p; s_dfn = (uint32_t)strtoul(e, &p, 16); s_dms = (p && *p == ',') ? (uint32_t)atoi(p + 1) : 0; } }
