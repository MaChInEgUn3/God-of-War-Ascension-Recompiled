+    PpuTraceLiveInit() {
+        if (getenv("PPU_DESC_CHECK") || getenv("PPU_DELAY_FN") || getenv("PPU_TRACE_DUMP") ||
+            getenv("PPU_TRACE_DUMP2")) return;
+        const char* m = getenv("PPU_TRACE_MAX");
+        if ((m ? atol(m) : 4000) <= 0) { ppu_trace_live = 0; return; }
+        const char* e = getenv("PPU_TRACE_ADDRS");
+        if (!e) return;
+        uint8_t* tmask = ppu_trace_parse_mask(e);
+        int any = 0;
