diff --git a/runtime/spu/tests/test_spu_fp_daz.c b/runtime/spu/tests/test_spu_fp_daz.c
new file mode 100644
index 00000000..49bf72e0
--- /dev/null
+++ b/runtime/spu/tests/test_spu_fp_daz.c
@@ -0,0 +1,44 @@
+/* SPU_FP_NATIVE with SPU_FP_DAZ on x86 (AVX2+FMA): the native fa/fs/fm/fma/fms/fnms under
+ * MXCSR round-toward-zero + FTZ + DAZ give the exact per-lane results (spu__*_lane) for
+ * random words and for words built around the edge exponents (0, 1, 2, 126-128, 253-255).
+ * Build: gcc -O2 -mavx2 -mfma -DSPU_FP_NATIVE=1 test_spu_fp_daz.c -lm */
+#include "../spu_helpers.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <xmmintrin.h>
+int g_spu_fp_check = 0;
+void spu_fp_check(int op, u128 a, u128 b, u128 c, u128 r) { (void)op; (void)a; (void)b; (void)c; (void)r; }
+static uint64_t s = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd(void) { s ^= s << 13; s ^= s >> 7; s ^= s << 17; return (uint32_t)s; }
+static uint32_t word(void) {
+    static const int ex[] = {0, 0, 1, 2, 63, 64, 100, 126, 127, 128, 150, 190, 252, 253, 254, 255, 255};
+    const uint32_t r = rnd();
+    switch (r & 3) {
+    case 0: return rnd();                                                       /* any word */
+    case 1: return (r & 0x80000000u) | ((uint32_t)ex[(r >> 8) % 17] << 23) | (rnd() & 0x7FFFFFu);
+    case 2: return (r & 0x80000000u) | ((uint32_t)ex[(r >> 8) % 17] << 23) | ((r >> 4) & 1 ? 0 : (rnd() & 0x7FFFFFu)); /* exact powers */
+    default: return (r & 0x80000000u) | ((uint32_t)(r >> 8) % 3 ? ((uint32_t)(60 + (rnd() % 8)) << 23) | (rnd() & 0x7FFFFFu) : 0);
+    }                                                                           /* small: underflow in fm */
+}
+int main(void) {
+    _mm_setcsr(_mm_getcsr() | 0x6000u | 0x8040u);
+    long bad = 0, n = 0;
+    for (long it = 0; it < 20000000; it++) {
+        u128 a, b, c;
+        for (int i = 0; i < 4; i++) { a._u32[i] = word(); b._u32[i] = word(); c._u32[i] = word(); }
+        /* fma with c near a*b's negation: cancellation */
+        if ((it & 7) == 0) for (int i = 0; i < 4; i++) c._u32[i] = spu__fm_lane(a._u32[i], b._u32[i]) ^ 0x80000000u ^ (rnd() & 3);
+        const u128 r[6] = { spu_fa(a, b), spu_fs(a, b), spu_fm(a, b), spu_fma(a, b, c), spu_fms(a, b, c), spu_fnms(a, b, c) };
+        for (int i = 0; i < 4; i++) {
+            const uint32_t x = a._u32[i], y = b._u32[i], z = c._u32[i];
+            const uint32_t e[6] = { spu__fa_lane(x, y), spu__fa_lane(x, y ^ 0x80000000u), spu__fm_lane(x, y),
+                                    spu__fma_lane(x, y, z, 0, 0), spu__fma_lane(x, y, z, 0, 0x80000000u),
+                                    spu__fma_lane(x, y, z, 0x80000000u, 0) };
+            for (int k = 0; k < 6; k++, n++)
+                if (r[k]._u32[i] != e[k] && bad++ < 10)
+                    printf("op %d: %08X %08X %08X -> %08X, exact %08X\n", k, x, y, z, r[k]._u32[i], e[k]);
+        }
+    }
+    printf("%s (%ld lane results, %ld differ)\n", bad ? "FAIL" : "ok", n, bad);
+    return bad != 0;
+}
diff --git a/runtime/spu/tests/test_spu_int_x86.c b/runtime/spu/tests/test_spu_int_x86.c
new file mode 100644
index 00000000..3c0610f8
--- /dev/null
+++ b/runtime/spu/tests/test_spu_int_x86.c
@@ -0,0 +1,86 @@
+/* x86 (SSE4.1/AVX2) SPU helpers vs their scalar spu_X_ref, on random and edge inputs.
+ *
+ *   clang -O2 -mavx2 -Iruntime/spu -Iruntime -Iinclude \
+ *         runtime/spu/tests/test_spu_int_x86.c -o test_spu_int_x86 && ./test_spu_int_x86
+ *
+ * With -msse4.1 in place of -mavx2 it checks the SSE4.1-only set (the variable shifts are
+ * then their own references).
+ *
+ * The generate-controls (spu_cbd_pos & co.) lost their byte loops on every host; they are
+ * checked here against those loops, kept below as the reference. */
+#include "spu_helpers.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+#if !SPU_X86
+#error "build with -msse4.1 or -mavx2 (SPU_X86 off)"
+#endif
+
+static uint64_t s_rng = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd(void) { s_rng ^= s_rng << 13; s_rng ^= s_rng >> 7; s_rng ^= s_rng << 17; return (uint32_t)s_rng; }
+/* Mostly random words, with the small and boundary values shifts and compares care about. */
+static uint32_t rword(void) {
+    static const uint32_t edge[] = {0, 1, 2, 3, 7, 8, 15, 16, 17, 31, 32, 33, 63, 64, 0x7F, 0x80, 0xFF,
+                                    0x7FFF, 0x8000, 0xFFFF, 0x10000, 0x7FFFFFFF, 0x80000000u, 0xFFFFFFFFu,
+                                    0xFFFFFFF0u, 0xFFFFFFE0u, 0x00800080u, 0x80008000u, 0x7F7F7F7Fu};
+    switch (rnd() & 3) {
+    case 0: return edge[rnd() % (sizeof edge / sizeof edge[0])];
+    case 1: return rnd() & 0x3F;
+    default: return rnd();
+    }
+}
+static u128 rv(void) { u128 r; for (int i = 0; i < 4; i++) r._u32[i] = rword(); return r; }
+static int s_fail;
+static void cmp(const char* name, u128 got, u128 want, u128 a, u128 b, u128 c, int imm) {
+    if (memcmp(&got, &want, 16) == 0) return;
+    if (s_fail++ < 20)
+        printf("FAIL %s imm=%d a=%08X%08X%08X%08X b=%08X%08X%08X%08X c=%08X..\n  got  %08X %08X %08X %08X\n  want %08X %08X %08X %08X\n",
+               name, imm, a._u32[0], a._u32[1], a._u32[2], a._u32[3], b._u32[0], b._u32[1], b._u32[2], b._u32[3], c._u32[0],
+               got._u32[0], got._u32[1], got._u32[2], got._u32[3], want._u32[0], want._u32[1], want._u32[2], want._u32[3]);
+}
+
+/* The loops the generate-controls had. */
+static u128 ref_cbd_pos(int pos) { u128 r; for (int t = 0; t < 16; t++) r._u8[SPU_W(t)] = (uint8_t)(0x10 + t);
+    r._u8[SPU_W(pos & 0xF)] = 0x03; return r; }
+static u128 ref_chd_pos(int pos) { u128 r; for (int t = 0; t < 16; t++) r._u8[SPU_W(t)] = (uint8_t)(0x10 + t);
+    int p = (pos & 0xF) & ~1; r._u8[SPU_W(p)] = 0x02; r._u8[SPU_W(p + 1)] = 0x03; return r; }
+static u128 ref_cwd_pos(int pos) { u128 r; for (int t = 0; t < 16; t++) r._u8[SPU_W(t)] = (uint8_t)(0x10 + t);
+    int p = (pos & 0xF) & ~3; for (int k = 0; k < 4; k++) r._u8[SPU_W(p + k)] = (uint8_t)k; return r; }
+static u128 ref_cdd_pos(int pos) { u128 r; for (int t = 0; t < 16; t++) r._u8[SPU_W(t)] = (uint8_t)(0x10 + t);
+    int p = (pos & 0xF) & ~7; for (int k = 0; k < 8; k++) r._u8[SPU_W(p + k)] = (uint8_t)k; return r; }
+
+#define T2(f)  cmp(#f, f(a, b), f##_ref(a, b), a, b, z, 0)
+#define T3(f)  cmp(#f, f(a, b, c), f##_ref(a, b, c), a, b, c, 0)
+#define T1(f)  cmp(#f, f(a), f##_ref(a), a, z, z, 0)
+#define TI(f)  cmp(#f, f(a, imm), f##_ref(a, imm), a, z, z, imm)
+
+int main(void) {
+    const u128 z = spu_zero();
+    for (long n = 0; n < 2000000; n++) {
+        const u128 a = rv(), b = rv(), c = rv();
+        const int imm = (int)(rnd() % 3 == 0 ? (int32_t)rword() : (int32_t)(rnd() % 256) - 128);
+        T2(spu_a); T2(spu_sf); T2(spu_and); T2(spu_or); T2(spu_xor);
+        T2(spu_ceq); T2(spu_cgt); T2(spu_clgt); T3(spu_selb);
+        TI(spu_ai); TI(spu_sfi); TI(spu_andi); TI(spu_ori); TI(spu_xori);
+        TI(spu_ceqi); TI(spu_cgti); TI(spu_clgti);
+        TI(spu_shlqbyi); TI(spu_rotqbyi); TI(spu_rotqmbyi);
+        T2(spu_shlqby); T2(spu_rotqby); T2(spu_shlqbybi); T2(spu_rotqbybi); T2(spu_rotqmby); T2(spu_rotqmbybi);
+        TI(spu_cwd);
+        T2(spu_absdb); T2(spu_avgb); T2(spu_ceqb); T2(spu_cgtb); T2(spu_clgtb);
+        T2(spu_ceqh); T2(spu_cgth); T2(spu_clgth); T2(spu_ah); T2(spu_sfh);
+        T2(spu_shl); T2(spu_rot); T2(spu_rotm); T2(spu_rotma); T2(spu_cg); T2(spu_bg);
+        T2(spu_mpy); T2(spu_mpyu); T2(spu_mpyh); T2(spu_mpyhh); T2(spu_mpyhhu); T2(spu_mpys);
+        TI(spu_ceqbi); TI(spu_cgtbi); TI(spu_clgtbi); TI(spu_ceqhi); TI(spu_cgthi); TI(spu_clgthi);
+        TI(spu_ahi); TI(spu_sfhi); TI(spu_mpyi); TI(spu_mpyui);
+        TI(spu_rothi); TI(spu_roti); TI(spu_rotmahi); TI(spu_rotmai);
+        T3(spu_mpya); T3(spu_mpyhha); T3(spu_mpyhhau); T3(spu_addx); T3(spu_sfx);
+        T1(spu_cntb); T1(spu_xsbh); T1(spu_xshw);
+        const int pos = (int)rnd();
+        cmp("cbd_pos", spu_cbd_pos(pos), ref_cbd_pos(pos), z, z, z, pos);
+        cmp("chd_pos", spu_chd_pos(pos), ref_chd_pos(pos), z, z, z, pos);
+        cmp("cwd_pos", spu_cwd_pos(pos), ref_cwd_pos(pos), z, z, z, pos);
+        cmp("cdd_pos", spu_cdd_pos(pos), ref_cdd_pos(pos), z, z, z, pos);
+    }
+    printf(s_fail ? "%d FAILURES\n" : "all x86 SPU helpers match their references\n", s_fail);
+    return s_fail != 0;
+}
diff --git a/runtime/spu/tests/test_spu_irqwait_diag.c b/runtime/spu/tests/test_spu_irqwait_diag.c
new file mode 100644
index 00000000..00a787c8
--- /dev/null
+++ b/runtime/spu/tests/test_spu_irqwait_diag.c
@@ -0,0 +1,67 @@
+/* SPU_IRQWAIT_DIAG: an SPU with interrupts enabled and nothing pending reports
+ * itself every 2^22 such dispatches, and with the variable unset the gate the
+ * dispatch loop reads settles at 0 after the first call. Usage:
+ *   test_spu_irqwait_diag on <log>    (SPU_IRQWAIT_DIAG=1 SPU_IRQWAIT_LS=12A0)
+ *   test_spu_irqwait_diag off         (neither set) */
+#include "spu_context.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+
+/* The runtime services the linked SPU sources name; none runs here. */
+void ppu_resv_break_store(uint64_t ea) { (void)ea; abort(); }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; abort(); }
+unsigned long long ps3_ms_now(void) { abort(); }
+uint32_t g_ww_lo = 0xFFFFFFFFu, g_ww_hi; int g_resv_store_active;
+uint32_t g_barrier_sync_watch;
+uint32_t g_ydkj_real_spurs_ea, g_ydkj_real_taskset_ea, g_ydkj_real_taskid;
+void spurs_ef_set_from_spu(uint32_t ea, uint16_t bits) { (void)ea; (void)bits; abort(); }
+void ydkj_wake_all_event_flags(void) { abort(); }
+void spurs_pm_build_context(spu_context* c, uint32_t a, uint32_t b, uint32_t d)
+{ (void)c; (void)a; (void)b; (void)d; abort(); }
+uint32_t g_spu_image_src_ea, g_spu_image_ls_start, g_spu_image_span;
+void spu_thread_publish_ctx(uint32_t tid, void* c) { (void)tid; (void)c; abort(); }
+
+static uint8_t s_ls[SPU_LS_SIZE];
+static spu_context s_ctx;
+
+int main(int argc, char** argv)
+{
+    int on = argc > 1 && strcmp(argv[1], "on") == 0;
+    s_ctx.ls = s_ls;
+    s_ctx.pc = 0x1234;
+    s_ctx.int_enable = 1;
+    s_ctx.event_mask = 0x2;           /* waiting for Sn ... */
+    s_ctx.event_status = 0;           /* ... which never arrives */
+    s_ctx.list_stall_mask = 0x10;
+    s_ls[0x12A0] = 0xAB; s_ls[0x12AF] = 0xCD;
+    if (on && !freopen(argv[2], "w", stderr)) return 2;
+
+    const unsigned long long n = 3ull << 22;
+    for (unsigned long long i = 0; i < n; i++) spu_irqwait_diag(&s_ctx);
+
+    if (!on) {
+        int ok = g_spu_irqwait_diag == 0;
+        printf("%s: gate %d with SPU_IRQWAIT_DIAG unset\n", ok ? "PASS" : "FAIL", g_spu_irqwait_diag);
+        return ok ? 0 : 1;
+    }
+    fclose(stderr);
+    FILE* f = fopen(argv[2], "r");
+    char line[512];
+    int lines = 0, good = 0;
+    while (f && fgets(line, sizeof line, f)) {
+        if (strncmp(line, "[irq-wait]", 10)) continue;
+        lines++;
+        good += strstr(line, "pc=0x01234") && strstr(line, "status=0x0 mask=0x2") &&
+                strstr(line, "list_stall_mask=0x10") &&
+                strstr(line, "LS[012A0]=AB000000 00000000 00000000 000000CD") != NULL;
+    }
+    if (f) fclose(f);
+    int ok = lines == 3 && good == 3 && g_spu_irqwait_diag == 1;
+    printf("%s: %d report(s) for %llu dispatches, %d with the expected state\n",
+           ok ? "PASS" : "FAIL", lines, n, good);
+    return ok ? 0 : 1;
+}
diff --git a/runtime/spu/tests/test_spu_lockline_peer.c b/runtime/spu/tests/test_spu_lockline_peer.c
index 4bf08693..5ab1c4af 100644
--- a/runtime/spu/tests/test_spu_lockline_peer.c
+++ b/runtime/spu/tests/test_spu_lockline_peer.c
@@ -27,6 +27,12 @@
  * asserted, the raise then happens under the lock, and only afterwards is the
  * acknowledge let through.
  *
+ * Two more, after the PUTLLUC cases, cover the GETLLAR that skips the lock
+ * (spu_coh_reserve_fast): that it really is lock-free for a registered holder
+ * on a marked line and still waits otherwise, and -- raced for real this
+ * time, because the point is the memory ordering -- that a write racing it is
+ * either in the copy or ends the reservation with SPU_EVENT_LR, never neither.
+ *
  * spu_channels.c is compiled in rather than linked, because spu_mfc_atomic()
  * is file-static: the same reason test_spu_mfc_slots.c does it.
  *
@@ -45,6 +51,7 @@
  */
 
 #include <pthread.h>
+#include <stdatomic.h>
 #include <stdint.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -263,6 +270,176 @@ static void test_putlluc_breaks_peer(void)
     CHECK(g_spu_lr_raise == raised + 1);
 }
 
+/* ===========================================================================
+ * GETLLAR without the lock-line lock
+ *
+ * Which path a GETLLAR took is not visible in its result, so the first test
+ * pins it the way the acknowledge test does: hold the lock and see whether a
+ * GETLLAR on another thread completes. The waits decide nothing about the
+ * outcome; a GETLLAR that has not yet started cannot complete either.
+ * ===========================================================================*/
+static atomic_int g_llar_ea_sel, g_llar_entered, g_llar_done;
+
+static void* llar_thread(void* arg)
+{
+    (void)arg;
+    atomic_store(&g_llar_entered, 1);
+    spu_atomic(&g_a, LSA_A, atomic_load(&g_llar_ea_sel), MFC_GETLLAR_CMD);
+    atomic_store(&g_llar_done, 1);
+    return NULL;
+}
+
+/* 1 if a GETLLAR of ea by g_a completed while this thread held the lock. */
+static int llar_completes_under_held_lock(uint32_t ea)
+{
+    atomic_store(&g_llar_ea_sel, (int)ea);
+    atomic_store(&g_llar_entered, 0);
+    atomic_store(&g_llar_done, 0);
+    spu_lockline_lock();
+    pthread_t t;
+    if (pthread_create(&t, NULL, llar_thread, NULL) != 0) {
+        spu_lockline_unlock();
+        return -1;
+    }
+    while (!atomic_load(&g_llar_entered)) YieldProcessor();
+    for (int i = 0; i < 2000 && !atomic_load(&g_llar_done); i++) Sleep(1);
+    int done = atomic_load(&g_llar_done);
+    spu_lockline_unlock();
+    pthread_join(t, NULL);
+    return done;
+}
+
+static void test_registered_getllar_skips_the_lock(void)
+{
+    reset_pair();
+    spu_atomic(&g_a, LSA_A, LINE_A, MFC_GETLLAR_CMD);   /* registers, marks */
+    g_guest_mem[LINE_A + 5] = 0x77;
+
+    TEST("a registered holder's GETLLAR of a marked line does not wait for the lock");
+    CHECK(llar_completes_under_held_lock(LINE_A) == 1);
+    CHECK(g_a.resv_valid == 1);
+    CHECK_EQ_U32(g_a.resv_ea, LINE_A);
+    CHECK_EQ_U32(g_a.ls[LSA_A + 5], 0x77);
+    CHECK_EQ_U32(g_a.resv_line[5], 0x77);
+    CHECK_EQ_U32(g_a.atomic_stat, 4);
+
+    TEST("...and the reservation it took is still ended by a peer's commit");
+    stage(&g_b, LSA_B, 0xB0, 128);
+    spu_atomic(&g_b, LSA_B, LINE_A, MFC_PUTLLUC_CMD);
+    CHECK_EQ_U32(g_a.event_status & SPU_EVENT_LR, SPU_EVENT_LR);
+    CHECK(g_a.resv_valid == 0);
+
+    /* LINE_B has never been reserved, so its mark is set by this GETLLAR and
+     * must be set under the lock. */
+    TEST("a GETLLAR of an unmarked line still takes the lock");
+    CHECK(llar_completes_under_held_lock(LINE_B + 0x80) == 0);
+    CHECK(g_a.resv_valid == 1);
+    CHECK_EQ_U32(g_a.resv_ea, LINE_B + 0x80);
+
+    /* A context the holder list does not know (coh_listed clear) must link
+     * itself first, under the lock, or no writer would ever find it. */
+    TEST("an unregistered context's GETLLAR of a marked line still takes the lock");
+    spu_coh_unregister(&g_a);
+    CHECK(g_a.coh_listed == 0);
+    CHECK(llar_completes_under_held_lock(LINE_A) == 0);
+    CHECK(g_a.coh_listed == 1);
+}
+
+/* A write racing a lock-free GETLLAR, for real. Two threads are released
+ * together each round, with skewed start delays so the copy and the write
+ * overlap at varying offsets: g_a's GETLLAR on one, and on the other a write
+ * of the whole line with a new byte -- alternately the PPU's coherent store
+ * (lock, write, notify) and a peer SPU's PUTLLUC. Afterwards g_a must hold
+ * either a valid reservation whose copy is the new line throughout, or no
+ * reservation and SPU_EVENT_LR. A reservation that survives with an old or
+ * torn copy is the lost update the fences exist to prevent. */
+#define RACE_ROUNDS 200000
+static atomic_int g_race_go, g_race_reader_done, g_race_writer_done;
+
+static void race_delay(unsigned n) { for (unsigned i = 0; i < n; i++) YieldProcessor(); }
+
+static void* race_reader(void* arg)
+{
+    (void)arg;
+    for (int k = 1; k <= RACE_ROUNDS; k++) {
+        while (atomic_load(&g_race_go) != k) { }
+        race_delay((unsigned)(k * 7) & 31u);
+        spu_atomic(&g_a, LSA_A, LINE_A, MFC_GETLLAR_CMD);
+        atomic_store(&g_race_reader_done, k);
+    }
+    return NULL;
+}
+
+static void* race_writer(void* arg)
+{
+    (void)arg;
+    for (int k = 1; k <= RACE_ROUNDS; k++) {
+        while (atomic_load(&g_race_go) != k) { }
+        race_delay((unsigned)(k * 13) & 31u);
+        const uint8_t v = (uint8_t)(k % 255 + 1);
+        if (k & 1) {
+            spu_lockline_lock();
+            memset(g_guest_mem + LINE_A, v, 128);
+            spu_coh_notify_write(LINE_A);
+            spu_lockline_unlock();
+        } else {
+            memset(g_b.ls + LSA_B, v, 128);
+            spu_atomic(&g_b, LSA_B, LINE_A, MFC_PUTLLUC_CMD);
+        }
+        atomic_store(&g_race_writer_done, k);
+    }
+    return NULL;
+}
+
+static void test_racing_write_ends_lockfree_reservation(void)
+{
+    reset_pair();
+    spu_atomic(&g_a, LSA_A, LINE_A, MFC_GETLLAR_CMD);   /* registers, marks */
+    spu_atomic(&g_b, LSA_B, LINE_A, MFC_GETLLAR_CMD);
+    atomic_store(&g_race_go, 0);
+    atomic_store(&g_race_reader_done, 0);
+    atomic_store(&g_race_writer_done, 0);
+
+    pthread_t r, w;
+    if (pthread_create(&r, NULL, race_reader, NULL) != 0) {
+        TEST("race threads start"); CHECK(0); return;
+    }
+    if (pthread_create(&w, NULL, race_writer, NULL) != 0) {
+        atomic_store(&g_race_go, -1);
+        TEST("race threads start"); CHECK(0); return;
+    }
+
+    unsigned long saw_write = 0, lost = 0, stale_kept = 0, lost_no_event = 0;
+    for (int k = 1; k <= RACE_ROUNDS; k++) {
+        g_a.event_status = 0;
+        atomic_store(&g_race_go, k);
+        while (atomic_load(&g_race_reader_done) != k ||
+               atomic_load(&g_race_writer_done) != k) { }
+        const uint8_t v = (uint8_t)(k % 255 + 1);
+        int whole = 1;
+        for (int i = 0; i < 128; i++)
+            if (g_a.ls[LSA_A + i] != v || g_a.resv_line[i] != v) { whole = 0; break; }
+        if (g_a.resv_valid) {
+            if (whole) saw_write++; else stale_kept++;
+        } else {
+            lost++;
+            if (!(g_a.event_status & SPU_EVENT_LR)) lost_no_event++;
+        }
+    }
+    pthread_join(r, NULL);
+    pthread_join(w, NULL);
+
+    printf("  lock-free GETLLAR race: %lu saw the write, %lu lost the reservation\n",
+           saw_write, lost);
+    TEST("a write racing a lock-free GETLLAR is in its copy or ends its reservation");
+    CHECK(stale_kept == 0);
+    TEST("...and a reservation it ends raises SPU_EVENT_LR");
+    CHECK(lost_no_event == 0);
+    TEST("...and the race exercised both outcomes");
+    CHECK(saw_write > 0);
+    CHECK(lost > 0);
+}
+
