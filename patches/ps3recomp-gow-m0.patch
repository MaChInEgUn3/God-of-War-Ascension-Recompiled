+    uint32_t sp = (uint32_t)g_active_ctx->gpr[1];
+    fprintf(stderr, "[STKSCAN:%s] r1=0x%08X lr=0x%08X r28=0x%08X r29=0x%08X r30=0x%08X r31=0x%08X\n",
