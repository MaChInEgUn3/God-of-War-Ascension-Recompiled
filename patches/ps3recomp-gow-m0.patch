+    static uint32_t dfn = 1, dreg = 0, dlen = 0, ddef = 0;   /* ddef = extra pointer hops before dumping */
+    if (dfn == 1) { dfn = 0; const char* e = getenv("PPU_TRACE_DUMP");
+        if (e) { char* p = nullptr; dfn = (uint32_t)strtoul(e, &p, 16);
+                 if (p && *p == ',') { dreg = (uint32_t)strtoul(p + 1, &p, 0);   /* >=32: absolute guest EA (use 0x...) */
+                     if (p && *p == ',') { dlen = (uint32_t)strtoul(p + 1, &p, 16);
+                         if (p && *p == ',') ddef = (uint32_t)strtoul(p + 1, &p, 10); } } } }
+    if (dfn && addr == dfn && dlen) {
+        uint32_t base = dreg < 32 ? (uint32_t)ctx->gpr[dreg] : dreg;
+        for (uint32_t h = 0; h < ddef; h++) base = vm_read32(base);
+        fprintf(stderr, "[FN %08X]   mem@%08X:", addr, base);
+        for (uint32_t o = 0; o < dlen && o < 0x200; o += 4) fprintf(stderr, " %08X", vm_read32(base + o));
+        fprintf(stderr, "\n");
+    }
+}
