+          long k = (s_rep_i - n) % GCM_REP_N; if (k < 0) k += GCM_REP_N;
+          if (s_rep_t[k]) fprintf(stderr, "[walk]   report-done io=%08X arg=%08X %llu ms ago\n", s_rep_io[k], s_rep_arg[k], now - s_rep_t[k]);
