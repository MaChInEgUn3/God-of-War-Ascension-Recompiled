+/* GCM_PARKLOG=1: log each self-JUMP park the walker reaches and when (and to
+ * what) it is released, every PPU store of a "JUMP to the next word" into the
+ * ring ([kick], the title's park release), every SPU PUT that writes over the
+ * current park ([park-patch]) and any SPU PUT that puts a self-JUMP back over a
+ * park the PPU already released ([park-reset]). */
+static volatile uint32_t g_gcm_park_ea = 0;
+static u32 s_park_io = 0xFFFFFFFFu;
+static unsigned long long s_park_t0 = 0;
+/* Walker history for the [walk] report: the last JUMPs taken and the last
+ * main-memory GET_REPORTs executed (io, arg, time). */
+extern unsigned long long ps3_ms_now(void);
+#define GCM_JMP_N 32
+static u32 s_jmp_from[GCM_JMP_N], s_jmp_to[GCM_JMP_N];
+static unsigned long long s_jmp_t[GCM_JMP_N];
+static volatile long s_jmp_i = 0;
+#define GCM_REP_N 48
+static u32 s_rep_io[GCM_REP_N], s_rep_arg[GCM_REP_N];
+static unsigned long long s_rep_t[GCM_REP_N];
+static volatile long s_rep_i = 0;
+#define GCM_KICK_N 16
+static volatile u32 s_kick_ea[GCM_KICK_N], s_kick_io[GCM_KICK_N];
+static unsigned long long s_kick_t[GCM_KICK_N];
+static volatile long s_kick_i = 0;
+static u32 gcm_ea2io(u32 ea);
+static void gcm_ppu_jump_store(uint32_t ea, uint32_t v)
+{
+    u32 io = gcm_ea2io(ea);
+    if (io == 0xFFFFFFFFu || (v & 0x1FFFFFFCu) != io + 4u) return;    /* JUMP to the next word */
+    extern unsigned long long ps3_ms_now(void);
+    long k = InterlockedIncrement(&s_kick_i) % GCM_KICK_N;
+    s_kick_ea[k] = ea; s_kick_io[k] = io; s_kick_t[k] = ps3_ms_now();
+    static volatile long n = 0;
+    if (InterlockedIncrement(&n) <= 20000)
+        fprintf(stderr, "[kick] PPU released io=0x%08X (get=0x%08X) t=%llu\n", io, s_fifo_getoff, s_kick_t[k]);
+}
+/* Ring of the last SPU PUTs into the FIFO ring (IO GCM_PUTRING=<lo>-<hi>, hex,
+ * default 0x280000-0xA80000): the [walk] report lists those near get. */
+#define GCM_SPUPUT_N 512
+static struct { u32 io, size, w0, pc; int img; unsigned wid; unsigned long long t; } s_sput[GCM_SPUPUT_N];
+static volatile long s_sput_i = 0;
+static u32 s_sput_lo = 1, s_sput_hi = 0;
+static void gcm_spu_put(uint32_t ea, uint32_t size, const uint8_t* src, uint32_t cmd,
+                        int img, unsigned wid, uint32_t pc)
+{
+    extern unsigned long long ps3_ms_now(void);
+    const u32 pe = g_gcm_park_ea;
+    if (pe && ea <= pe && ea + size >= pe + 4u) {
+        const uint8_t* d = src + (pe - ea);
+        fprintf(stderr, "[park-patch] SPU img=%d wid=%u pc=0x%05X cmd=0x%02X ea=0x%08X size=0x%X -> park 0x%08X new=%02X%02X%02X%02X\n",
+                img, wid, pc, cmd, ea, size, pe, d[0], d[1], d[2], d[3]);
+    }
+    if (s_sput_lo == 1) {
+        const char* e = getenv("GCM_PUTRING"); s_sput_lo = 0x280000; s_sput_hi = 0xA80000;
+        if (e) { char* p; s_sput_lo = (u32)strtoul(e, &p, 16); if (p && *p == '-') s_sput_hi = (u32)strtoul(p + 1, 0, 16); }
+    }
+    { u32 io = gcm_ea2io(ea);
+      if (io != 0xFFFFFFFFu && io + size > s_sput_lo && io < s_sput_hi) {
+          long k = InterlockedIncrement(&s_sput_i) % GCM_SPUPUT_N;
+          s_sput[k].io = io; s_sput[k].size = size; s_sput[k].pc = pc; s_sput[k].img = img; s_sput[k].wid = wid;
+          s_sput[k].w0 = (u32)src[0] << 24 | (u32)src[1] << 16 | (u32)src[2] << 8 | src[3];
+          s_sput[k].t = ps3_ms_now();
+      } }
+    for (int k = 0; k < GCM_KICK_N; k++) {
+        const u32 ke = s_kick_ea[k];
+        if (!ke || ea > ke || ea + size < ke + 4u) continue;
+        const uint8_t* d = src + (ke - ea);
+        const u32 w = (u32)d[0] << 24 | (u32)d[1] << 16 | (u32)d[2] << 8 | d[3];
+        if (w != (0x20000000u | s_kick_io[k])) continue;
+        extern unsigned long long ps3_ms_now(void);
+        static volatile long n = 0;
+        if (InterlockedIncrement(&n) <= 400)
+            fprintf(stderr, "[park-reset] SPU img=%d wid=%u pc=0x%05X cmd=0x%02X ea=0x%08X size=0x%X re-parks io=0x%08X released %llu ms ago\n",
+                    img, wid, pc, cmd, ea, size, s_kick_io[k], ps3_ms_now() - s_kick_t[k]);
+    }
+}
+static int gcm_parklog(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        v = getenv("GCM_PARKLOG") ? 1 : 0;
+        if (v) {
+            extern void (*g_spu_put_observer)(uint32_t, uint32_t, const uint8_t*, uint32_t, int, unsigned, uint32_t);
+            extern void (*g_ppu_jump_store_observer)(uint32_t, uint32_t);
+            g_spu_put_observer = gcm_spu_put;
+            g_ppu_jump_store_observer = gcm_ppu_jump_store;
+        }
+    }
+    return v;
+}
+static void gcm_park_note(u32 io, u32 ea)
+{
+    if (!gcm_parklog() || io == s_park_io) return;
+    extern unsigned long long ps3_ms_now(void);
+    s_park_io = io; s_park_t0 = ps3_ms_now(); g_gcm_park_ea = ea;
+    static int n = 0;
+    if (n++ < 20000)
+        fprintf(stderr, "[park] RSX parked at io=0x%08X ea=0x%08X ref=0x%08X t=%llu\n", io, ea,
+                vm_read32(GCM_CONTROL_GUEST_ADDR + 8), s_park_t0);
+}
+static void gcm_park_check_release(u32 io, u32 w)
+{
+    if (s_park_io == 0xFFFFFFFFu || io != s_park_io || w == (0x20000000u | io)) return;
+    extern unsigned long long ps3_ms_now(void);
+    static int n = 0;
+    if (n++ < 20000)
+        fprintf(stderr, "[park] released io=0x%08X after %llu ms, word now 0x%08X\n", io,
+                ps3_ms_now() - s_park_t0, w);
+    s_park_io = 0xFFFFFFFFu; g_gcm_park_ea = 0;
+}
