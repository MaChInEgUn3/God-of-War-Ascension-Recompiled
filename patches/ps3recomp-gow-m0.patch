+static void gcm_park_check_release(u32 io, u32 w)
+{
+    if (s_park_io == 0xFFFFFFFFu || io != s_park_io || w == (0x20000000u | io)) return;
+    extern unsigned long long ps3_ms_now(void);
+    static int n = 0;
+    if (n++ < 20000)
+        fprintf(stderr, "[park] released io=0x%08X after %llu ms, word now 0x%08X\n", io,
