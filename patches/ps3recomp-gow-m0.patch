+    s_done++;
+    static int s_zlog = -1;
+    if (s_zlog < 0) { const char* e = getenv("SPURS_ZLOG"); s_zlog = (e && *e && *e != '0') ? 1 : 0; }
+    if (s_zlog)   /* SPURS_ZLOG=1: every element, raw words included */
+        printf("[ZLIB] #%d in=%08X out=%08X csz=%u cap=%u w4=%08X w5=%08X w6=%08X w7=%08X -> %d\n",
