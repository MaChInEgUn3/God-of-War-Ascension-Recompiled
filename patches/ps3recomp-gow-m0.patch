+/* Guest function-entry tracer (PPU_TRACE_FUNCS at lift time): logs the argument
+ * registers, caller and thread on entry. PPU_TRACE_MAX caps the output (default
+ * 4000 lines); PPU_TRACE_REGS=1 adds r11..r14 and the callee-saved r27..r31. */
+/* PPU_TRACE_ADDRS=<hex>[-<hex>],... -> a bit per code word below 0x800000. */
+static uint8_t* ppu_trace_parse_mask(const char* e)
+{
+    uint8_t* tmask = (uint8_t*)calloc(0x800000 / 4 / 8, 1);
+    while (*e) { char* p = nullptr; uint32_t lo = (uint32_t)strtoul(e, &p, 16), hi = lo;
+        if (p && *p == '-') hi = (uint32_t)strtoul(p + 1, &p, 16);
+        for (uint32_t a = lo; a <= hi && a < 0x800000; a += 4) tmask[(a >> 2) >> 3] |= 1u << ((a >> 2) & 7);
+        if (!p || p == e) break; e = p; while (*e == ',') e++; }
+    return tmask;
+}
+/* ppu_recomp.h skips the ppu_trace_enter call while this is 0 (a PPU_TRACE_FUNCS=all
+ * lift calls it on every guest function entry: 4.6% of GoW:A's main thread). It is
+ * cleared only when the tracer provably does nothing more: at startup when no
+ * extra (DESC_CHECK, DELAY_FN, TRACE_DUMP/2) is set and either the line cap is
+ * <= 0 or PPU_TRACE_ADDRS selects no lifted function (ab_exe.sh's ADDRS=0), and
+ * at run time by the tracer itself once its cap is spent with no extra set. */
