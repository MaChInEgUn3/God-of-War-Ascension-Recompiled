+    static uint32_t dfn[2] = { 1, 1 }, dreg[2], dlen[2], ddef[2], doff[2];
+    for (int k = 0; k < 2; k++) {
+        if (dfn[k] == 1) { dfn[k] = 0; const char* e = getenv(k ? "PPU_TRACE_DUMP2" : "PPU_TRACE_DUMP");
+            if (e) { char* p = nullptr; dfn[k] = (uint32_t)strtoul(e, &p, 16);
+                     if (p && *p == ',') { dreg[k] = (uint32_t)strtoul(p + 1, &p, 0);   /* >=32: absolute guest EA (use 0x...) */
+                         if (p && *p == '+') doff[k] = (uint32_t)strtoul(p + 1, &p, 0);
+                         if (p && *p == ',') { dlen[k] = (uint32_t)strtoul(p + 1, &p, 16);
+                             if (p && *p == ',') ddef[k] = (uint32_t)strtoul(p + 1, &p, 10); } } } }
+        if (dfn[k] && addr == dfn[k] && dlen[k]) {
+            uint32_t base = (dreg[k] < 32 ? (uint32_t)ctx->gpr[dreg[k]] : dreg[k]) + doff[k];
+            for (uint32_t h = 0; h < ddef[k]; h++) base = vm_read32(base);
+            fprintf(stderr, "[FN %08X]   mem@%08X:", addr, base);
+            for (uint32_t o = 0; o < dlen[k] && o < 0x200; o += 4) fprintf(stderr, " %08X", vm_read32(base + o));
+            fprintf(stderr, "\n");
+        }
+    }
+}
+
+/* Scan the live guest stack for specific 32-bit values (comma-separated hex) and
+ * print where they sit relative to r1, plus the callee-saved registers. Used to
+ * find which frame a bad argument originated in: the deepest frame that holds
+ * the value is where it entered the call chain. */
+extern "C" void ppu_guest_scan_stack(const char* tag, const char* values)
+{
+    if (!g_active_ctx || !values) return;
+    uint32_t want[8]; int nw = 0;
+    for (const char* p = values; *p && nw < 8; ) {
+        char* e = nullptr; unsigned long v = strtoul(p, &e, 16);
+        if (e == p) break;
+        want[nw++] = (uint32_t)v;
+        p = (*e == ',') ? e + 1 : e;
+    }
+    uint32_t sp = (uint32_t)g_active_ctx->gpr[1];
+    fprintf(stderr, "[STKSCAN:%s] r1=0x%08X lr=0x%08X r28=0x%08X r29=0x%08X r30=0x%08X r31=0x%08X\n",
+            tag ? tag : "?", sp, (uint32_t)g_active_ctx->lr, (uint32_t)g_active_ctx->gpr[28],
+            (uint32_t)g_active_ctx->gpr[29], (uint32_t)g_active_ctx->gpr[30],
+            (uint32_t)g_active_ctx->gpr[31]);
+    if (getenv("GCM_UNMAP_DUMP")) {
+        for (uint32_t off = 0; off < 0x400; off += 16)
+            fprintf(stderr, "[STKSCAN:%s]  +%03X: %08X %08X %08X %08X\n", tag ? tag : "?", off,
+                    vm_read32(sp + off), vm_read32(sp + off + 4), vm_read32(sp + off + 8), vm_read32(sp + off + 12));
+    }
+    for (uint32_t off = 0; off < 0x3000; off += 4) {
+        uint32_t v = vm_read32(sp + off);
+        for (int i = 0; i < nw; i++)
+            if (v == want[i])
+                fprintf(stderr, "[STKSCAN:%s]   r1+0x%04X = 0x%08X\n", tag ? tag : "?", off, v);
+    }
+    fflush(stderr);
+}
