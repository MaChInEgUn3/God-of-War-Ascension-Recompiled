@echo off
rem Configure the Vulkan build. Needs GOW_ROOT and the patched SDK at %GOW_ROOT%\local\tools\ps3recomp.
call "%GOW_ROOT%\scripts\env.bat" cmake -B build_vk -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_COMPILER=clang-cl -DCMAKE_CXX_COMPILER=clang-cl -DPS3RECOMP_DIR="%GOW_ROOT%/local/tools/ps3recomp" -DRECOMP_DIR="%GOW_ROOT%/local/recompiled" -DCMAKE_EXE_LINKER_FLAGS="dxguid.lib /MAP" -DPS3RECOMP_RSX_VULKAN=ON -DCMAKE_C_FLAGS="-I\"%GOW_ROOT%/local/tools/sdl2/inc\"" -DCMAKE_CXX_FLAGS="-I\"%GOW_ROOT%/local/tools/sdl2/inc\"" -DPS3RECOMP_VULKAN_INCLUDE_DIR="%GOW_ROOT%/local/tools/vulkan-headers/include" -DCMAKE_PREFIX_PATH="%GOW_ROOT%/local/tools/glslang/sdk/Library" -DSDL2_DIR="%GOW_ROOT%/local/tools/sdl2/SDL2-2.32.10/cmake" -DPS3RECOMP_FFMPEG_RUNTIME=ON -DPS3RECOMP_FFMPEG_INCLUDE_DIR="%GOW_ROOT%/local/tools/ffmpeg/sdk/include"
